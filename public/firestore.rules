rules_version = '2';
// Reglas de seguridad. Cópialas en Firebase → Firestore Database → Reglas → Publicar.
// - El entrenador es la primera cuenta de Google que entra a la app del entrenador (queda en meta/trainer).
// - Cada cliente entra con su link + código; su teléfono queda vinculado en links/{uid}.
// - Un cliente solo ve SU rutina, sus registros y la biblioteca. Nunca ve otros clientes ni tus notas privadas.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTrainer() {
      return signedIn()
        && exists(/databases/$(database)/documents/meta/trainer)
        && get(/databases/$(database)/documents/meta/trainer).data.uid == request.auth.uid;
    }
    function linked() { return signedIn() && exists(/databases/$(database)/documents/links/$(request.auth.uid)); }
    function myClient() { return get(/databases/$(database)/documents/links/$(request.auth.uid)).data.clientId; }

    match /meta/trainer {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    match /meta/profile {
      allow read: if signedIn();
      allow write: if isTrainer();
    }
    match /clients/{id} {
      allow read: if isTrainer() || (linked() && myClient() == id);
      allow write: if isTrainer();
    }
    match /privnotes/{id} {
      allow read, write: if isTrainer();
    }
    match /links/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isTrainer());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.code is string
        && get(/databases/$(database)/documents/clients/$(request.resource.data.clientId)).data.code == request.resource.data.code;
      allow delete: if isTrainer() || request.auth.uid == uid;
    }
    match /library/{id} {
      allow read: if isTrainer() || linked();
      allow write: if isTrainer();
    }
    match /templates/{id} {
      allow read, write: if isTrainer();
    }
    match /logs/{id} {
      allow read: if isTrainer() || (linked() && resource.data.clientId == myClient());
      allow create: if isTrainer() || (linked() && request.resource.data.clientId == myClient());
      allow update, delete: if isTrainer();
    }
    match /sessions/{id} {
      allow read: if isTrainer() || (linked() && resource.data.clientId == myClient());
      allow create: if isTrainer() || (linked() && request.resource.data.clientId == myClient());
      allow update, delete: if isTrainer();
    }
    // Teléfonos que reciben notificaciones: push/trainer/devices/* (tú) y push/{clientId}/devices/* (cada cliente)
    match /push/{owner}/devices/{dev} {
      allow create, update, delete: if (owner == 'trainer' && isTrainer()) || (owner != 'trainer' && linked() && myClient() == owner);
      allow read: if false;
    }
    // Imágenes de ejercicios subidas desde el panel (comprimidas)
    match /media/{id} {
      allow read: if isTrainer() || linked();
      allow write: if isTrainer();
    }
    // Entrenamiento en vivo: el entrenador y el cliente comparten la misma sesión
    match /live/{cid} {
      allow read, write: if isTrainer() || (linked() && myClient() == cid);
    }
  }
}
